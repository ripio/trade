FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libcurl4-openssl-dev \
    libssl-dev \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install nlohmann/json
RUN mkdir -p /usr/include/nlohmann
RUN wget -O /usr/include/nlohmann/json.hpp https://github.com/nlohmann/json/releases/download/v3.11.2/json.hpp

WORKDIR /usr/src/app

# Copy source files
COPY . .

# Build the application
RUN mkdir -p build && cd build && \
    cmake .. && \
    make

# Run the POST example
CMD ["./build/post"]
